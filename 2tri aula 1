<!DOCTYPE HTML>
<html lang="pt-br">
<head>
    <title> Formulario HTML</title>
    <meta charset="UTF-8">
</head>
<body>
    <h1>Cadastro de usuário</h1>
    <form action="cadastro.php" method="enviar">
        <label for="nome">Nome:</label>
        <input type="text" id="nome">
        <br>
        <label for="email">E-mail:</label>
        <input type="mail" id="email" name="email">
        <br>
        <label for="senha">Senha:</label>
        <input type="password" name="senha">
        <br>
        <label for="idade">idade:</label>
        <input type="number" id="idade" name="idade">
        <br>
        <label for="data">Data de nascimento:</label>
        <input type="date" id="nascimento">
        <br>
        <p>Turno:</p>
        <input type="radio" name="turno" id="manhã"> <label for="manhã">Manha</label>
        <input type="radio" name="turno" id="tarde"> <label for="tarde">Tarde</label>
        <input type="radio" name="turno" id="noite"> <label for="noite">Noite</label>
        <br>
        <p>Áreas de interesse</p>
        <input type="checkbox" name="area" id="programação"> <label for="programação">Programacao</label>
        <input type="checkbox" name="area" id="design"> <label for="design">design</label>
        <input type="checkbox" name="area" id="redes"> <label for="redes">redes</label>
        <br>
        <input type="submit" value="Limpar">
        <input type="reset" value="Enviar">
    </form>
</body>
</html>
